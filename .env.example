# ─────────────────────────────────────────
#  Interview Prep AI — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Groq API ──────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Get your key at: https://console.groq.com

# ── MongoDB ───────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interview_prep?retryWrites=true&w=majority
# Local MongoDB: mongodb://localhost:27017/interview_prep

# ── Google OAuth ──────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Get credentials at: https://console.cloud.google.com
# Authorized redirect URI: http://localhost:8501

# ── App Settings ──────────────────────────
SECRET_KEY=your_random_secret_key_for_jwt_sessions
APP_URL=http://localhost:8501
